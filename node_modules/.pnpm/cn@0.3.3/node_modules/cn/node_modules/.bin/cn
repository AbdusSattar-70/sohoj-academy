#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/sattar/all-projects/sohoj-academy/node_modules/.pnpm/cn@0.3.3/node_modules/cn/bin/node_modules:/home/sattar/all-projects/sohoj-academy/node_modules/.pnpm/cn@0.3.3/node_modules/cn/node_modules:/home/sattar/all-projects/sohoj-academy/node_modules/.pnpm/cn@0.3.3/node_modules:/home/sattar/all-projects/sohoj-academy/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/sattar/all-projects/sohoj-academy/node_modules/.pnpm/cn@0.3.3/node_modules/cn/bin/node_modules:/home/sattar/all-projects/sohoj-academy/node_modules/.pnpm/cn@0.3.3/node_modules/cn/node_modules:/home/sattar/all-projects/sohoj-academy/node_modules/.pnpm/cn@0.3.3/node_modules:/home/sattar/all-projects/sohoj-academy/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../bin/cn.mjs" "$@"
else
  exec node  "$basedir/../../bin/cn.mjs" "$@"
fi
